/**
 * PhishShield Gmail Add-on
 * MVP
 */

const PHISHSHIELD_API =
  'https://phishshield-app.onrender.com';

const TOKEN_PROPERTY =
  'PHISHSHIELD_GMAIL_TOKEN';


/**
 * Homepage shown when the add-on is opened.
 */
function buildHomeCard() {

  const token =
    PropertiesService
      .getUserProperties()
      .getProperty(TOKEN_PROPERTY);

  if (!token) {
    return buildConnectCard();
  }

  return CardService.newCardBuilder()

    .setHeader(
      CardService.newCardHeader()
        .setTitle('PhishShield')
        .setSubtitle('Phishing Email Protection')
    )

    .addSection(

      CardService.newCardSection()

        .addWidget(
          CardService.newTextParagraph()
            .setText(
              '<b>PhishShield is connected.</b><br>' +
              'Open an email and analyze it directly from Gmail.'
            )
        )

        .addWidget(
          CardService.newTextButton()
            .setText('Disconnect PhishShield')
            .setOnClickAction(
              CardService.newAction()
                .setFunctionName('disconnectPhishShield')
            )
        )
    )

    .build();
}


