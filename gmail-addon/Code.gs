  return CardService.newCardBuilder()

    .setHeader(
      CardService.newCardHeader()
        .setTitle('Connect PhishShield')
        .setSubtitle('Gmail Security Integration')
    )

    .addSection(

      CardService.newCardSection()

        .addWidget(
          CardService.newTextParagraph()
            .setText(
