{
  "timeZone": "Asia/Kolkata",
  "dependencies": {},
  "exceptionLogging": "STACKDRIVER",
  "runtimeVersion": "V8",
  "oauthScopes": [
    "https://www.googleapis.com/auth/gmail.addons.execute",
    "https://www.googleapis.com/auth/gmail.addons.current.message.readonly"
  ],
  "addOns": {
    "common": {
      "name": "PhishShield",
      "logoUrl": "https://phishshield-app.onrender.com/favicon.ico",
      "layoutProperties": {
        "primaryColor": "#2563eb",
        "secondaryColor": "#1e40af"
      },
      "homepageTrigger": {
        "runFunction": "buildHomeCard"
      }
    },
    "gmail": {
      "contextualTriggers": [
        {
          "unconditional": {},
          "onTriggerFunction": "buildGmailCard"
        }
      ]
    }
  }
}